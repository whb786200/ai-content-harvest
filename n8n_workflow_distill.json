{
  "name": "1052-OS 认知蒸馏流水线",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "周六10:00 触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://119.29.168.239:8899/api/wechat/rss",
        "method": "GET",
        "options": {}
      },
      "id": "fetch-rss",
      "name": "采集RSS文章",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// 解析RSS结果，提取文章列表\nconst items = $input.all();\nconst articles = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (data.articles && Array.isArray(data.articles)) {\n    for (const article of data.articles) {\n      articles.push({\n        title: article.title || '',\n        url: article.url || '',\n        pub_time: article.pub_time || '',\n        source: article.source || 'unknown'\n      });\n    }\n  }\n}\n\nreturn articles.map(a => ({ json: a }));"
      },
      "id": "parse-articles",
      "name": "解析文章列表",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "method": "GET",
        "options": {
          "redirect": "follow"
        }
      },
      "id": "fetch-article",
      "name": "抓取文章内容",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// HTML转Markdown\nconst items = $input.all();\nconst TurndownService = require('turndown');\nconst turndownService = new TurndownService();\n\nreturn items.map(item => {\n  const html = item.json.content || item.json.body || '';\n  const md = turndownService.turndown(html);\n  return {\n    json: {\n      ...item.json,\n      markdown: md,\n      file_name: `[${new Date().toISOString().slice(0,10).replace(/-/g,'')}]${item.json.title}.md`\n    }\n  };\n});"
      },
      "id": "html-to-md",
      "name": "HTML→Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "// 调用LLM进行认知蒸馏\nconst items = $input.all();\nconst apiUrl = 'https://api.siliconflow.cn/v1/chat/completions';\nconst apiKey = process.env.SILICONFLOW_API_KEY;\n\n// 这里用HTTP Request节点替代，本节点只做数据准备\nreturn items.map(item => {\n  const prompt = `请对以下文章进行认知蒸馏，提取：1.工具链 2.操作流 3.提示词 4.认知框架\\n\\n文章：${item.json.markdown.slice(0, 4000)}`;\n  return {\n    json: {\n      ...item.json,\n      distill_prompt: prompt\n    }\n  };\n});"
      },
      "id": "prep-distill",
      "name": "准备蒸馏Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "url": "https://api.siliconflow.cn/v1/chat/completions",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ {\\n  \"model\": \"Qwen/Qwen3-30B-A3B\",\\n  \"messages\": [{\"role\": \"user\", \"content\": $json.distill_prompt}],\\n  \"temperature\": 0.3\\n} }}",
        "options": {}
      },
      "id": "llm-distill",
      "name": "LLM认知蒸馏",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.file_name }}",
        "dataMode": "base64",
        "data": "={{ Buffer.from($json.markdown).toString('base64') }}"
      },
      "id": "save-raw",
      "name": "保存原始MD",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 12,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "distill-schedule",
      "name": "周六12:00 蒸馏",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 14,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "merge-schedule",
      "name": "周六14:00 合并",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 900]
    }
  ],
  "connections": {
